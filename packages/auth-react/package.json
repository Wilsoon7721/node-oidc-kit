{
  "name": "@wilsoon/auth-react",
  "version": "2.1.0",
  "description": "React context and hooks for OpenID Connect browser sessions",
  "keywords": [
    "oidc",
    "openid-connect",
    "react",
    "authentication",
    "hooks",
    "sso",
    "oauth2"
  ],
  "author": "Wilson Oon",
  "homepage": "https://github.com/Wilsoon7721/node-oidc-kit/tree/main/packages/auth-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wilsoon7721/node-oidc-kit.git",
    "directory": "packages/auth-react"
  },
  "bugs": {
    "url": "https://github.com/Wilsoon7721/node-oidc-kit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16",
    "react-dom": ">=16"
  },
  "dependencies": {
    "@wilsoon/auth-core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16",
    "@types/react": "^19.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}