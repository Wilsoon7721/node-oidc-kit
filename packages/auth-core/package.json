{
  "name": "@wilsoon/auth-core",
  "version": "2.0.1",
  "description": "Framework-agnostic OpenID Connect relying party: discovery, PKCE, and token verification for browsers, Node and edge runtimes",
  "keywords": [
    "oidc",
    "openid-connect",
    "oauth2",
    "pkce",
    "jwt",
    "authentication",
    "jose",
    "sso"
  ],
  "author": "Wilson Oon",
  "homepage": "https://github.com/Wilsoon7721/node-oidc-kit/tree/main/packages/auth-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wilsoon7721/node-oidc-kit.git",
    "directory": "packages/auth-core"
  },
  "bugs": {
    "url": "https://github.com/Wilsoon7721/node-oidc-kit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "jose": "^5.10.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
