    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "jose": "^5.10.0"
  },
  "engines": {
    "node": ">=18"
  }
}
