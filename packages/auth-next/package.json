{
  "name": "@wilsoon/auth-next",
  "version": "1.1.1",
  "description": "Next.js utilities for WilsoonID Auth",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint src/**/*.ts"
  },
  "license": "MIT",
  "peerDependencies": {
    "next": ">=14"
  },
  "dependencies": {
    "@wilsoon/auth-core": "workspace:*",
    "@wilsoon/auth-react": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsup": "^8.0.0",
    "next": "^16.0.0"
  }
}