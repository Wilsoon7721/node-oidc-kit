{
  "name": "@wilsoon/auth-next",
  "version": "3.0.0",
  "description": "OpenID Connect for the Next.js App Router: verified sessions, middleware and hardened cookie storage",
  "keywords": [
    "oidc",
    "openid-connect",
    "nextjs",
    "authentication",
    "middleware",
    "sso",
    "oauth2"
  ],
  "author": "Wilson Oon",
  "homepage": "https://github.com/Wilsoon7721/node-oidc-kit/tree/main/packages/auth-next#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wilsoon7721/node-oidc-kit.git",
    "directory": "packages/auth-next"
  },
  "bugs": {
    "url": "https://github.com/Wilsoon7721/node-oidc-kit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.mjs",
      "require": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "eslint src test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "next": ">=14"
  },
  "dependencies": {
    "@wilsoon/auth-core": "workspace:*",
    "@wilsoon/auth-react": "workspace:*"
  },
  "devDependencies": {
    "next": "^16.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}