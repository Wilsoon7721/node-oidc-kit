{
  "name": "@wilsoon/auth-machine",
  "version": "0.1.0",
  "description": "Server-only OAuth 2.0 client_credentials tokens with caching, single-flight and refresh-ahead",
  "keywords": [
    "oauth2",
    "client-credentials",
    "machine-to-machine",
    "m2m",
    "service-account",
    "token-cache",
    "oidc"
  ],
  "author": "Wilson Oon",
  "homepage": "https://github.com/Wilsoon7721/node-oidc-kit/tree/main/packages/auth-machine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wilsoon7721/node-oidc-kit.git",
    "directory": "packages/auth-machine"
  },
  "bugs": {
    "url": "https://github.com/Wilsoon7721/node-oidc-kit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}