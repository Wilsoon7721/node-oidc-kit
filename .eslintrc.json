{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    },
    "project": true
  },
  "plugins": [
    "@typescript-eslint",
    "deprecation",
    "jsdoc"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "coverage/",
    ".turbo/",
    "*.config.ts",
    "*.config.js"
  ],
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "eqeqeq": [
      "error",
      "smart"
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "CallExpression > MemberExpression[property.name='parseIdToken']",
        "message": "parseIdToken() does not verify the token. Use verifyIdToken() to authorize, or decodeIdTokenUnsafe() for display-only claims."
      },
      {
        "selector": "CallExpression > MemberExpression[property.name='isTokenExpired']",
        "message": "isTokenExpired() is deprecated. Use isTokenNearExpiry()."
      }
    ],
    "deprecation/deprecation": "warn",
    // Requires a doc comment on every exported function and class - the pieces someone
    // reads before they read the implementation. Deliberately NOT on MethodDefinition:
    // this codebase documents the why, not the what (see the README's house rules), and a
    // rule demanding JSDoc on every method would fight that on every one-line storage
    // adapter method (`getItem`, `setItem`, ...) whose contract is already documented once,
    // on the AuthStorage interface it implements.
    "jsdoc/require-jsdoc": [
      "warn",
      {
        "publicOnly": true,
        "require": {
          "FunctionDeclaration": true,
          "ClassDeclaration": true
        }
      }
    ],
    "jsdoc/require-param": "off",
    "jsdoc/require-returns": "off",
    "@typescript-eslint/naming-convention": [
      "error",
      {
        "selector": [
          "function",
          "method"
        ],
        "filter": {
          "regex": "(decode|parse|unverified)",
          "match": true
        },
        "custom": {
          "regex": "Unsafe$",
          "match": true
        },
        "format": [
          "camelCase"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/test/**/*.ts",
        "**/test/**/*.tsx",
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "parserOptions": {
        "project": null
      },
      "rules": {
        "no-restricted-syntax": "off",
        "@typescript-eslint/no-non-null-assertion": "off",
        "deprecation/deprecation": "off"
      }
    }
  ]
}