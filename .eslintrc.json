{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "plugins": ["@typescript-eslint"],
  "extends": ["eslint:recommended", "plugin:@typescript-eslint/recommended"],
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "ignorePatterns": ["dist/", "node_modules/", "coverage/", ".turbo/", "*.config.ts", "*.config.js"],
  "rules": {
    "@typescript-eslint/no-explicit-any": "off",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }
    ],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "eqeqeq": ["error", "smart"],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "CallExpression > MemberExpression[property.name='parseIdToken']",
        "message": "parseIdToken() does not verify the token. Use verifyIdToken() to authorize, or decodeIdTokenUnsafe() for display-only claims."
      },
      {
        "selector": "CallExpression > MemberExpression[property.name='isTokenExpired']",
        "message": "isTokenExpired() is deprecated. Use isTokenNearExpiry()."
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/test/**/*.ts", "**/test/**/*.tsx", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-restricted-syntax": "off",
        "@typescript-eslint/no-non-null-assertion": "off"
      }
    }
  ]
}
